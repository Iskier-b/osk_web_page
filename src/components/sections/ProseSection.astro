---
import { cn } from "@/lib/utils";

interface Props {
  title?: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<section class:list={cn("mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16", className)}>
  {title && <h2 class="text-foreground mb-6 text-2xl font-bold tracking-tight sm:text-3xl">{title}</h2>}
  <div
    class="text-foreground [&_a]:text-primary max-w-3xl space-y-4 text-base leading-relaxed [&_a]:underline-offset-4 hover:[&_a]:underline [&_h2]:mt-8 [&_h2]:text-xl [&_h2]:font-bold [&_h3]:mt-6 [&_h3]:text-lg [&_h3]:font-semibold [&_ol]:list-decimal [&_ol]:pl-5 [&_p]:text-base [&_ul]:list-disc [&_ul]:pl-5"
  >
    <slot />
  </div>
</section>
