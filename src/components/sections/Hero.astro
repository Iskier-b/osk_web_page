---
import { cn } from "@/lib/utils";

interface HeroImage {
  src: string;
  alt: string;
}

interface Props {
  title: string;
  subtitle?: string;
  pitches?: string[];
  image?: HeroImage;
  class?: string;
}

const { title, subtitle, pitches = [], image, class: className } = Astro.props;
---

<section class:list={cn("relative overflow-hidden", className)}>
  {
    image ? (
      <>
        <div class="relative min-h-[min(78vh,42rem)] w-full max-w-full">
          <img
            src={image.src}
            alt={image.alt}
            class="absolute inset-0 h-full w-full max-w-full object-cover"
            loading="eager"
            decoding="async"
          />
          <div
            class="from-background via-background/75 absolute inset-0 bg-gradient-to-t to-transparent"
            aria-hidden="true"
          />
          <div
            class="via-primary/10 pointer-events-none absolute inset-0 bg-gradient-to-br from-transparent to-transparent"
            aria-hidden="true"
          />
          <div class="relative mx-auto flex min-h-[min(78vh,42rem)] w-full max-w-6xl flex-col justify-end px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
            <div class="motion-enter max-w-3xl">
              <h1 class="text-foreground text-4xl font-extrabold tracking-tight break-words sm:text-5xl lg:text-6xl">
                {title}
              </h1>
              {subtitle && (
                <p class="text-foreground/90 mt-4 max-w-xl text-lg break-words sm:mt-5 sm:text-xl">{subtitle}</p>
              )}
            </div>
          </div>
        </div>
        {pitches.length > 0 && (
          <div data-reveal class="border-border/60 bg-secondary/35 border-b">
            <ul class="text-foreground mx-auto flex w-full max-w-6xl flex-col gap-3 px-4 py-8 text-base break-words sm:px-6 sm:py-10 sm:text-lg lg:flex-row lg:gap-10">
              {pitches.map((pitch) => (
                <li class="min-w-0 flex-1 leading-snug font-medium">{pitch}</li>
              ))}
            </ul>
          </div>
        )}
      </>
    ) : (
      <div class="from-secondary via-background to-accent/30 bg-gradient-to-br">
        <div class="mx-auto w-full max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:py-24">
          <div class="motion-enter max-w-3xl">
            <h1 class="text-foreground text-3xl font-extrabold tracking-tight break-words sm:text-4xl lg:text-5xl">
              {title}
            </h1>
            {subtitle && (
              <p class="text-muted-foreground mt-3 max-w-2xl text-base break-words sm:mt-4 sm:text-lg lg:text-xl">
                {subtitle}
              </p>
            )}
          </div>
          {pitches.length > 0 && (
            <ul
              data-reveal
              class="text-foreground/90 mt-8 max-w-2xl space-y-2 text-base break-words sm:mt-10 sm:text-lg"
            >
              {pitches.map((pitch) => (
                <li class="font-medium">{pitch}</li>
              ))}
            </ul>
          )}
        </div>
      </div>
    )
  }
</section>
