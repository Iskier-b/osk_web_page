---
import { cn } from "@/lib/utils";

interface Props {
  label: string;
  href: string;
  title?: string;
  class?: string;
}

const { label, href, title, class: className } = Astro.props;
---

<section
  data-reveal
  class:list={cn(
    "border-border/70 from-secondary/80 via-accent/40 to-secondary/60 relative overflow-hidden border-y bg-gradient-to-r",
    className,
  )}
>
  <div
    class="mx-auto flex w-full max-w-6xl flex-col items-stretch gap-5 px-4 py-12 sm:flex-row sm:items-center sm:justify-between sm:px-6 sm:py-14 lg:py-16"
  >
    {
      title && (
        <p class="text-foreground min-w-0 text-2xl font-extrabold tracking-tight break-words sm:text-3xl">{title}</p>
      )
    }
    <a
      href={href}
      class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex w-full shrink-0 items-center justify-center rounded-md px-6 py-3.5 text-center text-base font-bold break-words transition-colors sm:w-auto"
    >
      {label}
    </a>
  </div>
</section>
