---
import { cn } from "@/lib/utils";

interface Props {
  label: string;
  href: string;
  title?: string;
  class?: string;
}

const { label, href, title, class: className } = Astro.props;
---

<section class:list={cn("border-border/80 bg-secondary/60 border-y", className)}>
  <div
    class="mx-auto flex max-w-6xl flex-col items-start gap-4 px-4 py-12 sm:flex-row sm:items-center sm:justify-between sm:px-6 sm:py-14"
  >
    {title && <p class="text-foreground text-xl font-semibold tracking-tight sm:text-2xl">{title}</p>}
    <a
      href={href}
      class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center justify-center rounded-md px-5 py-2.5 text-sm font-semibold transition-colors"
    >
      {label}
    </a>
  </div>
</section>
