---
import { cn } from "@/lib/utils";

interface DashboardItem {
  title: string;
  body: string;
  href?: string;
  linkLabel?: string;
}

interface Props {
  items: DashboardItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

{
  items.length > 0 && (
    <section
      data-reveal
      class:list={cn("border-border/60 bg-secondary/35 border-b", className)}
      aria-label="Informacje skrótowe"
    >
      <div class="mx-auto grid w-full max-w-6xl gap-10 px-4 py-12 sm:px-6 sm:py-14 md:grid-cols-3 md:gap-8 lg:gap-12 lg:py-16">
        {items.map((item) => (
          <div class="min-w-0">
            <h2 class="text-primary text-xs font-bold tracking-[0.14em] break-words uppercase">{item.title}</h2>
            <p class="text-foreground mt-3 text-base leading-relaxed break-words whitespace-pre-line sm:text-lg">
              {item.body}
            </p>
            {item.href && item.linkLabel && (
              <a
                href={item.href}
                class="text-primary mt-4 inline-flex min-h-10 items-center text-sm font-semibold break-words hover:underline"
              >
                {item.linkLabel}
              </a>
            )}
          </div>
        ))}
      </div>
    </section>
  )
}
