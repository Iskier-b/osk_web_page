---
import { cn } from "@/lib/utils";

interface ChildLink {
  label: string;
  href: string;
}

interface Props {
  links: ChildLink[];
  ariaLabel: string;
  class?: string;
}

const { links, ariaLabel, class: className } = Astro.props;
---

{
  links.length > 0 && (
    <nav class:list={cn("mx-auto max-w-6xl px-4 pb-12 sm:px-6 sm:pb-16", className)} aria-label={ariaLabel}>
      <ul class="flex flex-col gap-2">
        {links.map((link) => (
          <li>
            <a href={link.href} class="text-primary text-base hover:underline">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
