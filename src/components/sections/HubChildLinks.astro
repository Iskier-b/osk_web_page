---
import { cn } from "@/lib/utils";

interface ChildLink {
  label: string;
  href: string;
}

interface Props {
  links: ChildLink[];
  ariaLabel: string;
  class?: string;
}

const { links, ariaLabel, class: className } = Astro.props;
---

{
  links.length > 0 && (
    <nav
      data-reveal
      class:list={cn("mx-auto w-full max-w-6xl px-4 pb-12 sm:px-6 sm:pb-14 lg:pb-20", className)}
      aria-label={ariaLabel}
    >
      <ul class="flex flex-col gap-1">
        {links.map((link) => (
          <li class="min-w-0">
            <a
              href={link.href}
              class="text-foreground hover:text-primary hover:bg-muted/70 flex min-h-12 items-center rounded-md px-3 text-base font-semibold break-words transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
