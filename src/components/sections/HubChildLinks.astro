---
import { cn } from "@/lib/utils";

interface ChildLink {
  label: string;
  href: string;
}

interface Props {
  links: ChildLink[];
  ariaLabel: string;
  class?: string;
}

const { links, ariaLabel, class: className } = Astro.props;
---

{
  links.length > 0 && (
    <nav
      class:list={cn("mx-auto w-full max-w-6xl px-4 pb-10 sm:px-6 sm:pb-12 lg:pb-16", className)}
      aria-label={ariaLabel}
    >
      <ul class="flex flex-col gap-2">
        {links.map((link) => (
          <li class="min-w-0">
            <a href={link.href} class="text-primary text-base break-words hover:underline">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
