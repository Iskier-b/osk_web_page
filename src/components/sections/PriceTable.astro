---
import { cn } from "@/lib/utils";

interface PriceRow {
  label: string;
  price?: string;
  note?: string;
}

interface Props {
  rows: PriceRow[];
  caption?: string;
  class?: string;
}

const { rows, caption, class: className } = Astro.props;
---

{
  rows.length > 0 && (
    <section
      class:list={cn("mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-12 lg:py-16", className)}
      aria-label={caption ?? "Cennik"}
    >
      {caption && (
        <h2 class="text-foreground mb-6 text-2xl font-bold tracking-tight break-words sm:text-3xl">{caption}</h2>
      )}

      {/* Narrow: stacked rows — avoids table overflow at 375px */}
      <ul class="divide-border border-border divide-y border md:hidden">
        {rows.map((row) => (
          <li class="min-w-0 px-4 py-4">
            <p class="text-foreground text-base font-medium break-words">{row.label}</p>
            {row.price && (
              <p class="text-foreground mt-1 text-lg font-semibold break-words tabular-nums">{row.price}</p>
            )}
            {row.note && <p class="text-muted-foreground mt-1 text-sm break-words">{row.note}</p>}
          </li>
        ))}
      </ul>

      {/* Tablet+ : full-width table, no forced min-width scroll */}
      <div class="border-border hidden w-full max-w-full overflow-x-auto border md:block">
        <table class="w-full table-fixed text-left text-base">
          <colgroup>
            <col class="w-[70%]" />
            <col class="w-[30%]" />
          </colgroup>
          <thead class="bg-secondary/70">
            <tr>
              <th class="text-foreground px-4 py-3 font-semibold" scope="col">
                Usługa
              </th>
              <th class="text-foreground px-4 py-3 font-semibold" scope="col">
                Cena
              </th>
            </tr>
          </thead>
          <tbody class="divide-border divide-y">
            {rows.map((row) => (
              <tr>
                <td class="text-foreground min-w-0 px-4 py-3 align-top break-words">
                  <span class="font-medium">{row.label}</span>
                  {row.note && <span class="text-muted-foreground mt-1 block text-sm">{row.note}</span>}
                </td>
                <td class="text-foreground px-4 py-3 align-top font-semibold break-words tabular-nums">
                  {row.price ?? "—"}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )
}
