---
import { cn } from "@/lib/utils";

interface Props {
  src: string;
  alt: string;
  caption?: string;
  class?: string;
}

const { src, alt, caption, class: className } = Astro.props;
---

<figure class:list={cn("max-w-full min-w-0 overflow-hidden", className)}>
  <img src={src} alt={alt} class="h-auto w-full max-w-full object-cover" loading="lazy" decoding="async" />
  {caption && <figcaption class="text-muted-foreground mt-2 text-sm break-words">{caption}</figcaption>}
</figure>
