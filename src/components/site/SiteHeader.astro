---
import SiteNav from "@/components/site/SiteNav";
import { brandName, homeHref } from "@/lib/site-nav";

const currentPath = Astro.url.pathname;
---

<header class="border-border/70 bg-background/90 sticky top-0 z-40 border-b backdrop-blur-md">
  <div
    class="via-primary/50 pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent to-transparent"
    aria-hidden="true"
  >
  </div>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6 sm:py-4">
    <a
      href={homeHref}
      class="text-foreground hover:text-primary min-w-0 shrink font-sans text-xl font-extrabold tracking-tight transition-colors sm:text-2xl"
    >
      {brandName}
    </a>
    <SiteNav client:load currentPath={currentPath} />
  </div>
</header>
