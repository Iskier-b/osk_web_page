---
import { brandName, footerLinks, phoneHref, phoneLabel } from "@/lib/site-nav";
---

<footer class="border-border relative mt-auto overflow-hidden border-t">
  <div
    class="from-primary/[0.07] via-muted/50 to-background pointer-events-none absolute inset-0 bg-gradient-to-br"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto flex max-w-6xl flex-col gap-10 px-4 py-12 sm:px-6 sm:py-14">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between lg:gap-12">
      <div class="max-w-sm space-y-3">
        <p class="text-foreground text-xl font-extrabold tracking-tight sm:text-2xl">{brandName}</p>
        <a
          href={phoneHref}
          class="text-foreground/85 hover:text-primary inline-flex text-base font-semibold transition-colors"
        >
          {phoneLabel}
        </a>
      </div>

      <nav aria-label="Mapa strony" class="min-w-0 flex-1">
        <p class="text-foreground mb-4 text-sm font-bold tracking-wide uppercase">Mapa strony</p>
        <ul class="grid gap-x-8 gap-y-2.5 sm:grid-cols-2">
          {
            footerLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-foreground/80 hover:text-primary inline-flex min-h-10 items-center text-sm font-medium transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="border-border/80 text-muted-foreground flex flex-col gap-2 border-t pt-5 text-sm sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {brandName}</p>
    </div>
  </div>
</footer>
