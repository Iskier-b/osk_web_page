---
interface ChildLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  childrenLinks?: ChildLink[];
}

const { title, childrenLinks } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
  <h1 class="text-foreground text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
  <p class="text-muted-foreground mt-3 text-base">Treść w przygotowaniu</p>

  {
    childrenLinks && childrenLinks.length > 0 && (
      <nav class="mt-8" aria-label={title}>
        <ul class="flex flex-col gap-2">
          {childrenLinks.map((link) => (
            <li>
              <a href={link.href} class="text-primary hover:underline">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</section>
