---
import Hero from "@/components/sections/Hero.astro";
import MediaFigure from "@/components/sections/MediaFigure.astro";
import ProseSection from "@/components/sections/ProseSection.astro";
import Layout from "@/layouts/Layout.astro";
import { setPageNotFound } from "@/lib/content/not-found";
import { isContentPage, loadPublicPage } from "@/lib/content/load-page";
import { getNewsTeasers } from "@/lib/content/pages";
import { brandName } from "@/lib/site-nav";

const page = await loadPublicPage("artykuly", Astro);
if ("notFound" in page) setPageNotFound(Astro);
const newsTeasers = await getNewsTeasers("artykuly");
---

{
  isContentPage(page) && (
    <Layout title={`${page.view.title} | ${brandName}`}>
      <Hero title={page.view.heroTitle} subtitle={page.view.heroSubtitle} />
      <div class="mx-auto w-full max-w-6xl px-4 pt-8 sm:px-6 sm:pt-10">
        <MediaFigure src="/images/osk/news-teaser-01.jpg" alt="Aktualności Auto Szkoły Juszczak" />
      </div>
      <ProseSection>{page.view.bodyHtml && <div set:html={page.view.bodyHtml} />}</ProseSection>
      {newsTeasers && newsTeasers.length > 0 && (
        <section data-reveal class="border-border/60 border-t" aria-label="Lista aktualności">
          <div class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 sm:py-14 lg:py-20">
            <ul class="max-w-3xl space-y-7">
              {newsTeasers.map((item) => (
                <li class="min-w-0">
                  <h2 class="text-foreground text-lg font-bold break-words sm:text-xl">{item.title}</h2>
                  {item.summary && <p class="text-muted-foreground mt-1.5 text-base break-words">{item.summary}</p>}
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}
    </Layout>
  )
}
