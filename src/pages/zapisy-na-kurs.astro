---
import EnrollmentForm from "@/components/forms/EnrollmentForm.astro";
import Hero from "@/components/sections/Hero.astro";
import Layout from "@/layouts/Layout.astro";
import { setPageNotFound } from "@/lib/content/not-found";
import { isFormPage, loadPublicPage } from "@/lib/content/load-page";
import { brandName } from "@/lib/site-nav";

const page = await loadPublicPage("zapisy-na-kurs", Astro);
if ("notFound" in page) setPageNotFound(Astro);
---

{
  isFormPage(page) && (
    <Layout title={`${page.view.title} | ${brandName}`}>
      <Hero title={page.view.title} />
      <EnrollmentForm />
    </Layout>
  )
}
