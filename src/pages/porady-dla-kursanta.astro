---
export const prerender = true;

import CtaBand from "@/components/sections/CtaBand.astro";
import Hero from "@/components/sections/Hero.astro";
import HubChildLinks from "@/components/sections/HubChildLinks.astro";
import ProseSection from "@/components/sections/ProseSection.astro";
import Layout from "@/layouts/Layout.astro";
import { getPageEntry } from "@/lib/content/pages";
import { brandName, strefaChildren } from "@/lib/site-nav";

const { entry, Content } = await getPageEntry("porady-dla-kursanta");
const { title, heroTitle, heroSubtitle, cta } = entry.data;
---

<Layout title={`${title} | ${brandName}`}>
  <Hero title={heroTitle ?? title} subtitle={heroSubtitle} />
  <ProseSection>
    <Content />
  </ProseSection>
  <section class="mx-auto w-full max-w-6xl px-4 sm:px-6" aria-labelledby="strefa-links-heading">
    <h2 id="strefa-links-heading" class="text-foreground mb-4 text-xl font-bold tracking-tight break-words sm:text-2xl">
      Tematy w strefie kursanta
    </h2>
  </section>
  <HubChildLinks links={strefaChildren} ariaLabel="Strefa kursanta — podstrony" />
  {cta && <CtaBand label={cta.label} href={cta.href} />}
</Layout>
