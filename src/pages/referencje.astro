---
import OpinionForm from "@/components/forms/OpinionForm.astro";
import Hero from "@/components/sections/Hero.astro";
import Layout from "@/layouts/Layout.astro";
import { setPageNotFound } from "@/lib/content/not-found";
import { isFormPage, loadPublicPage } from "@/lib/content/load-page";
import { brandName } from "@/lib/site-nav";

const page = await loadPublicPage("referencje", Astro);
if ("notFound" in page) setPageNotFound(Astro);
---

{
  isFormPage(page) && (
    <Layout title={`${page.view.title} | ${brandName}`}>
      <Hero title={page.view.title} subtitle={page.view.heroSubtitle} />
      <OpinionForm />
    </Layout>
  )
}
