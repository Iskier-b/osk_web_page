---
export const prerender = true;

import ContactForm from "@/components/forms/ContactForm.astro";
import Hero from "@/components/sections/Hero.astro";
import ProseSection from "@/components/sections/ProseSection.astro";
import Layout from "@/layouts/Layout.astro";
import { getPageEntry } from "@/lib/content/pages";
import { brandName } from "@/lib/site-nav";

const { entry, Content } = await getPageEntry("kontakt");
const { title, heroTitle, heroSubtitle } = entry.data;
---

<Layout title={`${title} | ${brandName}`}>
  <Hero title={heroTitle ?? title} subtitle={heroSubtitle} />
  <ProseSection>
    <Content />
  </ProseSection>
  <ContactForm />
</Layout>
